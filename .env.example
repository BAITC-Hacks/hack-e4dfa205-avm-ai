# ElevenLabs (синтез и распознавание речи)
# Ключ: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ID голоса по умолчанию, опционально
ELEVENLABS_VOICE_ID=
# Модель по умолчанию, опционально (например eleven_multilingual_v2)
ELEVENLABS_MODEL_ID=

# Exa (поиск в интернете)
# Ключ: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# OpenAI (AI-объяснение результата в симуляторе)
# Ключ: https://platform.openai.com/api-keys
# Пусто: приложение работает в резервном режиме, расчёт выполняется полностью
OPENAI_API_KEY=
# Модель, опционально
OPENAI_MODEL=gpt-4o-mini
# Таймаут запроса к модели в секундах, опционально
LLM_TIMEOUT_S=15
# Необязательно: другой OpenAI-совместимый провайдер, например NVIDIA NIM
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_MODEL=meta/llama-3.1-70b-instruct
